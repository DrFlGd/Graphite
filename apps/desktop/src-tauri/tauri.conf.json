{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphite",
  "version": "0.3.5",
  "identifier": "dev.graphite.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Graphite",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "label": "main"
      },
      {
        "label": "capture",
        "title": "Quick capture",
        "url": "index.html#capture",
        "width": 640,
        "height": 300,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
